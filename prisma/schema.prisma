// Platform baseline (P01-T03) + system identity core (P02-T01).
// Extend per database-schema-v1.md in later phases.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "system"]
}

model AuditLog {
  id             String   @id @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorSub       String?  @map("actor_sub")
  clientId       String?  @map("client_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  outcome        String
  requestId      String   @map("request_id")
  correlationId  String?  @map("correlation_id")
  beforeSummary  Json     @default("{}") @map("before_summary") @db.JsonB
  afterSummary   Json     @default("{}") @map("after_summary") @db.JsonB

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
  @@schema("platform")
}

model Attachment {
  id                String   @id @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version           Int      @default(1)
  ownerType         String   @map("owner_type")
  ownerId           String?  @map("owner_id") @db.Uuid
  bucket            String
  objectKey         String   @map("object_key")
  sha256Hex         String   @map("sha256_hex") @db.Char(64)
  mimeType          String   @map("mime_type")
  sizeBytes         BigInt   @map("size_bytes")
  scanState         String   @map("scan_state")
  visibility        String   @default("private")
  createdBySub      String   @map("created_by_sub")
  scannedAt         DateTime? @map("scanned_at") @db.Timestamptz(6)
  scanEngineVersion String?  @map("scan_engine_version")
  uploadKeyHash     String?  @unique @map("upload_key_hash") @db.Char(64)
  uploadPayloadHash String?  @map("upload_payload_hash") @db.Char(64)

  @@unique([bucket, objectKey])
  @@index([ownerType, ownerId])
  @@index([scanState, createdAt])
  @@map("attachment")
  @@schema("platform")
}

model CoreRecord {
  id            String   @id @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  kind          String
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  payload       Json     @db.JsonB
  visibility    String   @default("private")
  policyVersion String   @map("policy_version")
  checksumHex   String   @map("checksum_hex") @db.Char(64)
  builtAt       DateTime @map("built_at") @db.Timestamptz(6)

  @@unique([kind, sourceType, sourceId])
  @@index([kind, builtAt(sort: Desc)])
  @@map("core_record")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// system schema — P02-T01 identity core (database-schema-v1.md § P05)
// ---------------------------------------------------------------------------

model Organization {
  id            String   @id @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  /// Enforces single-organization constraint — always 1.
  singletonSlot Int      @default(1) @map("singleton_slot") @db.SmallInt
  instanceId    String   @unique @map("instance_id")
  code          String   @unique
  name          String
  contactEmail  String?  @map("contact_email")
  timezone      String   @default("Asia/Ho_Chi_Minh")
  status        String   @default("active")

  memberships   Membership[]

  @@unique([singletonSlot])
  @@map("organization")
  @@schema("system")
}

model Membership {
  id             String    @id @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  organizationId String    @map("organization_id") @db.Uuid
  keycloakSub    String    @unique @map("keycloak_sub")
  displayName    String    @map("display_name")
  email          String?
  role           String
  status         String    @default("invited")
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([role, status])
  @@map("membership")
  @@schema("system")
}

// ---------------------------------------------------------------------------
// system schema — P02-T04 partner federation (database-schema-v1.md § P05)
// ---------------------------------------------------------------------------

model Partner {
  id               String    @id @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version          Int       @default(1)
  /// Keycloak issuer URL of the remote instance; enforces uniqueness per partner.
  issuerInstanceId String    @unique @map("issuer_instance_id")
  code             String    @unique
  displayName      String    @map("display_name")
  status           String    @default("active")
  contactEmail     String?   @map("contact_email")
  createdBySub     String    @map("created_by_sub")

  connection       PartnerConnection?

  @@map("partner")
  @@schema("system")
}

model PartnerConnection {
  id                   String    @id @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version              Int       @default(1)
  partnerId            String    @unique @map("partner_id") @db.Uuid
  /// Remote API endpoint for outbound events.
  endpointUrl          String    @map("endpoint_url")
  /// Token endpoint of the remote Keycloak realm (outbound M2M).
  outboundTokenUrl     String    @map("outbound_token_url")
  /// Client ID granted by the remote realm for outbound calls.
  outboundClientId     String    @map("outbound_client_id")
  /// Reference to secret store key (never stored plaintext).
  outboundSecretRef    String    @map("outbound_secret_ref")
  /// Expected audience when calling remote.
  outboundAudience     String    @map("outbound_audience")
  /// Client ID registered in this local Keycloak realm for the partner's inbound calls.
  inboundClientId      String    @unique @map("inbound_client_id")
  /// Scope the partner must present on inbound tokens.
  allowedInboundScope  String    @default("federation:write") @map("allowed_inbound_scope")
  status               String    @default("active")
  lastVerifiedAt       DateTime? @map("last_verified_at") @db.Timestamptz(6)
  rotatedAt            DateTime? @map("rotated_at") @db.Timestamptz(6)

  partner              Partner   @relation(fields: [partnerId], references: [id])

  @@map("partner_connection")
  @@schema("system")
}
