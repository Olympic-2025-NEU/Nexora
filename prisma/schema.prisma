// SPDX-License-Identifier: AGPL-3.0-only
// Platform baseline (P01-T03) + system identity core (P02-T01).
// Extend per database-schema-v1.md in later phases.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform", "system", "catalog", "inventory", "trading", "traceability"]
}

model AuditLog {
  id             String   @id @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorSub       String?  @map("actor_sub")
  clientId       String?  @map("client_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  outcome        String
  requestId      String   @map("request_id")
  correlationId  String?  @map("correlation_id")
  beforeSummary  Json     @default("{}") @map("before_summary") @db.JsonB
  afterSummary   Json     @default("{}") @map("after_summary") @db.JsonB

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
  @@schema("platform")
}

model Attachment {
  id                String   @id @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version           Int      @default(1)
  ownerType         String   @map("owner_type")
  ownerId           String?  @map("owner_id") @db.Uuid
  bucket            String
  objectKey         String   @map("object_key")
  sha256Hex         String   @map("sha256_hex") @db.Char(64)
  mimeType          String   @map("mime_type")
  sizeBytes         BigInt   @map("size_bytes")
  scanState         String   @map("scan_state")
  visibility        String   @default("private")
  createdBySub      String   @map("created_by_sub")
  scannedAt         DateTime? @map("scanned_at") @db.Timestamptz(6)
  scanEngineVersion String?  @map("scan_engine_version")
  scanAttempts      Int      @default(0) @map("scan_attempts")
  scanErrorCode     String?  @map("scan_error_code")
  nextScanAt        DateTime? @map("next_scan_at") @db.Timestamptz(6)
  scanLeaseId       String?  @map("scan_lease_id") @db.Uuid
  scanLeaseUntil    DateTime? @map("scan_lease_until") @db.Timestamptz(6)
  quarantinePurgedAt DateTime? @map("quarantine_purged_at") @db.Timestamptz(6)
  uploadKeyHash     String?  @unique @map("upload_key_hash") @db.Char(64)
  uploadPayloadHash String?  @map("upload_payload_hash") @db.Char(64)

  @@unique([bucket, objectKey])
  @@index([ownerType, ownerId])
  @@index([scanState, createdAt])
  @@map("attachment")
  @@schema("platform")
}

model CoreRecord {
  id            String   @id @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  kind          String
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  payload       Json     @db.JsonB
  visibility    String   @default("private")
  policyVersion String   @map("policy_version")
  checksumHex   String   @map("checksum_hex") @db.Char(64)
  builtAt       DateTime @map("built_at") @db.Timestamptz(6)

  @@unique([kind, sourceType, sourceId])
  @@index([kind, builtAt(sort: Desc)])
  @@map("core_record")
  @@schema("platform")
}

model IdempotencyRecord {
  id             String   @id @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorOrClient  String   @map("actor_or_client")
  method         String
  routeKey       String   @map("route_key")
  idempotencyKey String   @map("idempotency_key")
  payloadSha256  String   @map("payload_sha256") @db.Char(64)
  state          String
  responseStatus Int?     @map("response_status") @db.SmallInt
  responseBody   Json?    @map("response_body") @db.JsonB
  resourceId     String?  @map("resource_id") @db.Uuid
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([actorOrClient, method, routeKey, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_record")
  @@schema("platform")
}

model OutboxMessage {
  id               String    @id @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  aggregateType    String    @map("aggregate_type")
  aggregateId      String    @map("aggregate_id") @db.Uuid
  aggregateVersion Int       @map("aggregate_version")
  eventType        String    @map("event_type")
  schemaVersion    String    @map("schema_version")
  payload          Json      @db.JsonB
  destination      String
  correlationId    String    @map("correlation_id")
  status           String    @default("pending")
  attemptCount     Int       @default(0) @map("attempt_count")
  nextAttemptAt    DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  leaseOwner       String?   @map("lease_owner")
  leaseUntil       DateTime? @map("lease_until") @db.Timestamptz(6)
  lastErrorCode    String?   @map("last_error_code")
  deliveredAt      DateTime? @map("delivered_at") @db.Timestamptz(6)

  @@unique([aggregateType, aggregateId, aggregateVersion, eventType, destination])
  @@index([correlationId])
  @@map("outbox_message")
  @@schema("platform")
}

enum ApprovalRequestState {
  requested
  starting
  pending
  decision_pending
  approved
  rejected
  confirmed
  cancelled
  halted

  @@map("approval_request_state")
  @@schema("platform")
}

model ApprovalRequest {
  id                        String               @id @db.Uuid
  documentId                String               @unique @map("document_id") @db.Uuid
  submittedDocumentVersion  Int                  @map("submitted_document_version")
  creatorSub                String               @map("creator_sub")
  warehouseIds              Json                 @map("warehouse_ids") @db.JsonB
  lineSnapshotSha256        String               @map("line_snapshot_sha256") @db.Char(64)
  state                     ApprovalRequestState @default(requested)
  flowableProcessId         String?              @unique @map("flowable_process_id")
  flowableDefinitionId      String?              @map("flowable_definition_id")
  flowableDefinitionVersion Int?                 @map("flowable_definition_version")
  flowableTaskId            String?              @map("flowable_task_id")
  decisionIntent            String?              @map("decision_intent")
  decisionIntentReason      String?              @map("decision_intent_reason")
  decisionRequestedBySub    String?              @map("decision_requested_by_sub")
  decisionRequestedAt       DateTime?            @map("decision_requested_at") @db.Timestamptz(6)
  decision                  String?
  decisionReason            String?              @map("decision_reason")
  approverSub               String?              @map("approver_sub")
  decidedAt                 DateTime?            @map("decided_at") @db.Timestamptz(6)
  engineCompletedAt         DateTime?            @map("engine_completed_at") @db.Timestamptz(6)
  cancelReason              String?              @map("cancel_reason")
  engineCleanupAt           DateTime?            @map("engine_cleanup_at") @db.Timestamptz(6)
  haltReason                String?              @map("halt_reason")
  confirmedBySub            String?              @map("confirmed_by_sub")
  confirmedAt               DateTime?            @map("confirmed_at") @db.Timestamptz(6)
  version                   Int                  @default(1)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  document                  Document             @relation(fields: [documentId], references: [id])

  @@index([state, updatedAt])
  @@map("approval_request")
  @@schema("platform")
}

// ---------------------------------------------------------------------------
// system schema — P02-T01 identity core (database-schema-v1.md § P05)
// ---------------------------------------------------------------------------

model Organization {
  id            String   @id @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  /// Enforces single-organization constraint — always 1.
  singletonSlot Int      @default(1) @map("singleton_slot") @db.SmallInt
  instanceId    String   @unique @map("instance_id")
  code          String   @unique
  name          String
  contactEmail  String?  @map("contact_email")
  contactPhone  String?  @map("contact_phone")
  address       String?
  timezone      String   @default("Asia/Ho_Chi_Minh")
  status        String   @default("active")

  memberships   Membership[]

  @@unique([singletonSlot])
  @@map("organization")
  @@schema("system")
}

model Membership {
  id             String    @id @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  organizationId String    @map("organization_id") @db.Uuid
  keycloakSub    String    @unique @map("keycloak_sub")
  displayName    String    @map("display_name")
  email          String?
  role           String
  status         String    @default("invited")
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id])
  warehouses     MembershipWarehouse[]

  @@index([role, status])
  @@map("membership")
  @@schema("system")
}

model MembershipWarehouse {
  membershipId String   @map("membership_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  membership Membership @relation(fields: [membershipId], references: [id])
  warehouse  Warehouse  @relation(fields: [warehouseId], references: [id])

  @@id([membershipId, warehouseId])
  @@index([warehouseId, membershipId])
  @@map("membership_warehouse")
  @@schema("system")
}

// ---------------------------------------------------------------------------
// system schema — P02-T04 partner federation (database-schema-v1.md § P05)
// ---------------------------------------------------------------------------

model Partner {
  id               String    @id @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version          Int       @default(1)
  /// Keycloak issuer URL of the remote instance; enforces uniqueness per partner.
  issuerInstanceId String    @unique @map("issuer_instance_id")
  code             String    @unique
  displayName      String    @map("display_name")
  status           String    @default("active")
  contactEmail     String?   @map("contact_email")
  createdBySub     String    @map("created_by_sub")

  connection       PartnerConnection?
  transfers        TransferDetail[]

  @@map("partner")
  @@schema("system")
}

model PartnerConnection {
  id                   String    @id @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version              Int       @default(1)
  partnerId            String    @unique @map("partner_id") @db.Uuid
  /// Remote API endpoint for outbound events.
  endpointUrl          String    @map("endpoint_url")
  /// Token endpoint of the remote Keycloak realm (outbound M2M).
  outboundTokenUrl     String    @map("outbound_token_url")
  /// Client ID granted by the remote realm for outbound calls.
  outboundClientId     String    @map("outbound_client_id")
  /// Reference to secret store key (never stored plaintext).
  outboundSecretRef    String    @map("outbound_secret_ref")
  /// Expected audience when calling remote.
  outboundAudience     String    @map("outbound_audience")
  /// Client ID registered in this local Keycloak realm for the partner's inbound calls.
  inboundClientId      String    @unique @map("inbound_client_id")
  /// Scope the partner must present on inbound tokens.
  allowedInboundScope  String    @default("federation:write") @map("allowed_inbound_scope")
  status               String    @default("active")
  lastVerifiedAt       DateTime? @map("last_verified_at") @db.Timestamptz(6)
  rotatedAt            DateTime? @map("rotated_at") @db.Timestamptz(6)

  partner              Partner   @relation(fields: [partnerId], references: [id])

  @@map("partner_connection")
  @@schema("system")
}

// ---------------------------------------------------------------------------
// catalog schema — P06 + P065 (variant / UOM / price)
// ---------------------------------------------------------------------------

model Category {
  id             String    @id @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int       @default(1)
  code           String    @unique
  name           String
  nameNormalized String    @map("name_normalized")
  parentId       String?   @map("parent_id") @db.Uuid
  sortOrder      Int       @default(0) @map("sort_order")
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBySub   String    @map("created_by_sub")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("category")
  @@schema("catalog")
}

model Uom {
  id              String    @id @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version         Int       @default(1)
  code            String    @unique
  name            String
  nameKey         String    @unique @map("name_key")
  kind            String
  isSystemDefault Boolean   @default(false) @map("is_system_default")
  isActive        Boolean   @default(true) @map("is_active")
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  variantUoms    ProductVariantUom[]
  priceListItems PriceListItem[]
  documentLines  DocumentLine[]

  @@map("uom")
  @@schema("catalog")
}

model Product {
  id           String    @id @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version      Int       @default(1)
  name         String
  searchText   String    @default("") @map("search_text")
  attributes   Json      @default("{}") @db.JsonB
  categoryId   String    @map("category_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBySub String    @map("created_by_sub")

  category Category         @relation(fields: [categoryId], references: [id])
  variants ProductVariant[]
  images   ProductImage[]
  batches  Batch[]
  documentLines DocumentLine[]

  @@index([isActive, name])
  @@map("product")
  @@schema("catalog")
}

model ProductVariant {
  id           String    @id @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version      Int       @default(1)
  productId    String    @map("product_id") @db.Uuid
  sku          String?
  barcode      String?
  isPrimary    Boolean   @default(false) @map("is_primary")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBySub String    @map("created_by_sub")

  product        Product             @relation(fields: [productId], references: [id])
  codes          VariantCode[]
  uoms           ProductVariantUom[]
  batches        Batch[]
  priceListItems PriceListItem[]
  balances       StockBalance[]
  movements      StockMovement[]
  documentLines  DocumentLine[]

  @@map("product_variant")
  @@schema("catalog")
}

model VariantCode {
  code      String @id
  variantId String @map("variant_id") @db.Uuid
  source    String

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_code")
  @@schema("catalog")
}

model ProductVariantUom {
  id               String  @id @db.Uuid
  productVariantId String  @map("product_variant_id") @db.Uuid
  uomId            String  @map("uom_id") @db.Uuid
  isStockKeeping   Boolean @default(false) @map("is_stock_keeping")
  factorToStockUom Decimal @map("factor_to_stock_uom") @db.Decimal(20, 3)

  variant ProductVariant @relation(fields: [productVariantId], references: [id])
  uom     Uom            @relation(fields: [uomId], references: [id])

  @@unique([productVariantId, uomId])
  @@map("product_variant_uom")
  @@schema("catalog")
}

model ProductImage {
  id           String    @id @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  productId    String    @map("product_id") @db.Uuid
  attachmentId String    @map("attachment_id") @db.Uuid
  sortOrder    Int       @default(0) @map("sort_order")
  isPrimary    Boolean   @default(false) @map("is_primary")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [id])

  @@map("product_image")
  @@schema("catalog")
}

model PriceList {
  id           String    @id @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version      Int       @default(1)
  code         String?
  name         String
  isDefault    Boolean   @default(false) @map("is_default")
  validFrom    DateTime  @map("valid_from") @db.Timestamptz(6)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(6)
  isActive     Boolean   @default(true) @map("is_active")
  currency     String    @db.Char(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdBySub String    @map("created_by_sub")

  items PriceListItem[]

  @@map("price_list")
  @@schema("catalog")
}

model PriceListItem {
  id               String   @id @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  priceListId      String   @map("price_list_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  uomId            String   @map("uom_id") @db.Uuid
  priceType        String   @map("price_type")
  amount           Decimal  @db.Decimal(20, 3)
  isActive         Boolean  @default(true) @map("is_active")

  priceList PriceList      @relation(fields: [priceListId], references: [id])
  variant   ProductVariant @relation(fields: [productVariantId], references: [id])
  uom       Uom            @relation(fields: [uomId], references: [id])

  @@unique([priceListId, productVariantId, uomId, priceType])
  @@map("price_list_item")
  @@schema("catalog")
}

model Batch {
  id                     String    @id @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  version                Int       @default(1)
  productId              String    @map("product_id") @db.Uuid
  productVariantId       String    @map("product_variant_id") @db.Uuid
  localCode              String    @map("local_code")
  originIssuerInstanceId String    @map("origin_issuer_instance_id")
  originLotId            String    @map("origin_lot_id")
  manufacturedOn         DateTime? @map("manufactured_on") @db.Date
  expiresOn              DateTime? @map("expires_on") @db.Date
  qualityStatus          String    @default("inspect") @map("quality_status")
  sourcePartnerId        String?   @map("source_partner_id") @db.Uuid
  createdBySub           String?   @map("created_by_sub")
  createdByClientId      String?   @map("created_by_client_id")

  product  Product        @relation(fields: [productId], references: [id])
  variant  ProductVariant @relation(fields: [productVariantId], references: [id])
  balances StockBalance[]
  movements StockMovement[]
  documentLines DocumentLine[]
  traceEvents TraceEvent[]
  passportProjection PassportProjection?
  passportPolicies PassportPolicy[]
  qrTokens QrToken[]

  @@unique([productId, localCode])
  @@unique([productVariantId, localCode])
  @@unique([originIssuerInstanceId, originLotId])
  @@unique([id, productId])
  @@unique([id, productVariantId])
  @@map("batch")
  @@schema("catalog")
}

// ---------------------------------------------------------------------------
// inventory schema — P06 M02
// ---------------------------------------------------------------------------

model Warehouse {
  id           String   @id @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version      Int      @default(1)
  code         String   @unique
  name         String
  status       String
  createdBySub String   @map("created_by_sub")

  memberships MembershipWarehouse[]
  balances    StockBalance[]
  movements   StockMovement[]
  documentLines DocumentLine[]

  @@map("warehouse")
  @@schema("inventory")
}

model StockBalance {
  warehouseId      String   @map("warehouse_id") @db.Uuid
  batchId          String   @map("batch_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Decimal  @default(0) @db.Decimal(20, 3)
  version          Int      @default(1)
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  batch     Batch          @relation(fields: [batchId, productVariantId], references: [id, productVariantId])
  variant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@id([warehouseId, batchId])
  @@index([productVariantId, batchId])
  @@index([warehouseId, productVariantId])
  @@map("stock_balance")
  @@schema("inventory")
}

model StockMovement {
  id               String   @id @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  warehouseId      String   @map("warehouse_id") @db.Uuid
  batchId          String   @map("batch_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  sourceLineId     String   @map("source_line_id") @db.Uuid
  kind             String
  delta            Decimal  @db.Decimal(20, 3)
  balanceAfter     Decimal  @map("balance_after") @db.Decimal(20, 3)
  actorSub         String   @map("actor_sub")
  correlationId    String   @map("correlation_id")
  reversalOf       String?  @map("reversal_of") @db.Uuid

  warehouse  Warehouse       @relation(fields: [warehouseId], references: [id])
  batch      Batch           @relation(fields: [batchId, productVariantId], references: [id, productVariantId])
  variant    ProductVariant  @relation(fields: [productVariantId], references: [id])
  reversal   StockMovement?  @relation("StockMovementReversal", fields: [reversalOf], references: [id])
  reversedBy StockMovement[] @relation("StockMovementReversal")
  sourceLine DocumentLine @relation(fields: [sourceLineId], references: [id])

  @@unique([sourceLineId, kind])
  @@index([batchId, createdAt(sort: Desc)])
  @@index([warehouseId, batchId, createdAt(sort: Desc)])
  @@map("stock_movement")
  @@schema("inventory")
}

model Document {
  id                     String   @id @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version                Int      @default(1)
  documentType           String   @map("document_type")
  issuePurpose           String?  @map("issue_purpose")
  documentNumber         String   @map("document_number")
  status                 String   @default("draft")
  createdBySub           String   @map("created_by_sub")
  confirmedBySub         String?  @map("confirmed_by_sub")
  confirmedAt            DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt            DateTime? @map("cancelled_at") @db.Timestamptz(6)
  note                   String?
  correctionOfDocumentId String?  @map("correction_of_document_id") @db.Uuid
  correctionReason       String?  @map("correction_reason")
  correlationId          String   @map("correlation_id")

  correctionOf Document? @relation("DocumentCorrection", fields: [correctionOfDocumentId], references: [id])
  corrections  Document[] @relation("DocumentCorrection")
  lines        DocumentLine[]
  transferDetail TransferDetail? @relation("TransferDocument")
  receivingDetail ReceivingDetail?
  saleDetail SaleDetail? @relation("SaleDocument")
  transferIssues TransferDetail[] @relation("TransferIssue")
  saleIssues SaleDetail[] @relation("SaleIssue")
  approvals ApprovalRequest[]
  traceEvents TraceEvent[]

  @@unique([documentType, documentNumber], map: "uq_trading_document_number")
  @@index([status, createdAt(sort: Desc)], map: "idx_trading_document_status_time")
  @@index([documentType, createdAt(sort: Desc)], map: "idx_trading_document_type_time")
  @@index([correctionOfDocumentId], map: "idx_trading_document_correction")
  @@map("document")
  @@schema("trading")
}

model DocumentLine {
  id                String   @id @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  documentId        String   @map("document_id") @db.Uuid
  lineNo            Int      @map("line_no")
  warehouseId       String   @map("warehouse_id") @db.Uuid
  batchId           String   @map("batch_id") @db.Uuid
  productVariantId  String   @map("product_variant_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  quantity          Decimal? @db.Decimal(20, 3)
  actualQuantity    Decimal? @map("actual_quantity") @db.Decimal(20, 3)
  countedQuantity   Decimal? @map("counted_quantity") @db.Decimal(20, 3)
  uomId             String   @map("uom_id") @db.Uuid
  sourceIssueLineId String?  @map("source_issue_line_id") @db.Uuid
  sourceLineRef     String?  @map("source_line_ref") @db.Uuid

  document Document @relation(fields: [documentId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  batch Batch @relation(fields: [batchId, productVariantId], references: [id, productVariantId])
  variant ProductVariant @relation(fields: [productVariantId], references: [id])
  product Product @relation(fields: [productId], references: [id])
  uom Uom @relation(fields: [uomId], references: [id])
  sourceIssueLine DocumentLine? @relation("IssueLine", fields: [sourceIssueLineId], references: [id])
  linkedLines DocumentLine[] @relation("IssueLine")
  movements StockMovement[]

  @@unique([documentId, lineNo], map: "uq_trading_line_number")
  @@unique([id, documentId], map: "uq_trading_line_document")
  @@index([batchId, documentId], map: "idx_trading_line_batch_document")
  @@map("document_line")
  @@schema("trading")
}

model TransferDetail {
  documentId          String    @id @map("document_id") @db.Uuid
  linkedIssueId       String    @map("linked_issue_id") @db.Uuid
  destinationPartnerId String   @map("destination_partner_id") @db.Uuid
  deliveryState       String    @default("pending") @map("delivery_state")
  technicalAckAt      DateTime? @map("technical_ack_at") @db.Timestamptz(6)
  businessReceiptAt   DateTime? @map("business_receipt_at") @db.Timestamptz(6)

  document Document @relation("TransferDocument", fields: [documentId], references: [id])
  linkedIssue Document @relation("TransferIssue", fields: [linkedIssueId], references: [id])
  destinationPartner Partner @relation(fields: [destinationPartnerId], references: [id])

  @@index([destinationPartnerId], map: "idx_trading_transfer_partner")
  @@index([linkedIssueId], map: "idx_trading_transfer_issue")
  @@map("transfer_detail")
  @@schema("trading")
}

model ReceivingDetail {
  documentId             String   @id @map("document_id") @db.Uuid
  sourceIssuerInstanceId String   @map("source_issuer_instance_id")
  sourceTransferId       String   @map("source_transfer_id")
  inboundMessageId       String?  @map("inbound_message_id") @db.Uuid
  sentQuantity           Decimal  @map("sent_quantity") @db.Decimal(20, 3)
  actualQuantity         Decimal? @map("actual_quantity") @db.Decimal(20, 3)
  discrepancyReason      String?  @map("discrepancy_reason")

  document Document @relation(fields: [documentId], references: [id])

  @@index([sourceIssuerInstanceId, sourceTransferId], map: "idx_trading_receiving_source")
  @@map("receiving_detail")
  @@schema("trading")
}

model InboundMessage {
  messageId           String   @id @map("message_id") @db.Uuid
  eventType           String   @map("event_type")
  issuerInstanceId    String   @map("issuer_instance_id")
  recipientInstanceId String   @map("recipient_instance_id")
  payload             Json
  payloadHash         String   @map("payload_hash") @db.Char(64)
  receivedAt          DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  @@index([receivedAt(sort: Desc)], map: "idx_inbound_message_received")
  @@map("inbound_message")
  @@schema("platform")
}

model SaleDetail {
  documentId    String   @id @map("document_id") @db.Uuid
  linkedIssueId String   @map("linked_issue_id") @db.Uuid
  buyerRef      String?  @map("buyer_ref")
  soldAt        DateTime @map("sold_at") @db.Timestamptz(6)

  document Document @relation("SaleDocument", fields: [documentId], references: [id])
  linkedIssue Document @relation("SaleIssue", fields: [linkedIssueId], references: [id])

  @@index([linkedIssueId], map: "idx_trading_sale_issue")
  @@map("sale_detail")
  @@schema("trading")
}

// P08 — append-only provenance. Federation source FK is added in P09.
model TraceEvent {
  id                     String   @id @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  issuerInstanceId       String   @map("issuer_instance_id")
  externalEventId        String   @map("external_event_id")
  eventType              String   @map("event_type")
  batchId                String?  @map("batch_id") @db.Uuid
  documentId             String?  @map("document_id") @db.Uuid
  sourceMessageId        String?  @map("source_message_id") @db.Uuid
  originIssuerInstanceId String   @map("origin_issuer_instance_id")
  originLotId            String   @map("origin_lot_id")
  occurredAt             DateTime @map("occurred_at") @db.Timestamptz(6)
  verificationState      String   @map("verification_state")
  payloadVersion         String   @map("payload_version")
  summary                Json     @db.JsonB
  evidenceRefs           String[] @default([]) @map("evidence_refs") @db.Uuid
  checksumHex            String   @map("checksum_hex") @db.Char(64)

  batch     Batch?     @relation(fields: [batchId], references: [id])
  document  Document?  @relation(fields: [documentId], references: [id])
  outgoing  TraceLink[] @relation("TraceLinkFrom")
  incoming  TraceLink[] @relation("TraceLinkTo")

  @@unique([issuerInstanceId, externalEventId], map: "uq_trace_event_external")
  @@index([batchId, occurredAt], map: "idx_trace_event_batch_time")
  @@index([originIssuerInstanceId, originLotId, occurredAt], map: "idx_trace_event_origin_time")
  @@map("trace_event")
  @@schema("traceability")
}

model TraceLink {
  id                String   @id @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  fromEventId       String   @map("from_event_id") @db.Uuid
  toEventId         String?  @map("to_event_id") @db.Uuid
  missingRef        Json?    @map("missing_ref") @db.JsonB
  relation          String
  verificationState String   @map("verification_state")

  fromEvent TraceEvent  @relation("TraceLinkFrom", fields: [fromEventId], references: [id])
  toEvent   TraceEvent? @relation("TraceLinkTo", fields: [toEventId], references: [id])

  @@index([toEventId], map: "idx_trace_link_to_event")
  @@map("trace_link")
  @@schema("traceability")
}

model PassportProjection {
  id             String   @id @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version        Int      @default(1)
  batchId        String   @unique(map: "uq_passport_batch") @map("batch_id") @db.Uuid
  publicPayload  Json     @map("public_payload") @db.JsonB
  sourceEventIds String[] @default([]) @map("source_event_ids") @db.Uuid
  policyVersion  String   @map("policy_version")
  builtAt        DateTime @map("built_at") @db.Timestamptz(6)
  state          String   @default("stale")
  checksumHex    String   @map("checksum_hex") @db.Char(64)

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([state, builtAt], map: "idx_passport_state_built")
  @@map("passport_projection")
  @@schema("traceability")
}

model PassportPolicy {
  id                     String    @id @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  batchId                String    @map("batch_id") @db.Uuid
  policyVersion          Int       @map("policy_version")
  state                  String    @default("draft")
  organizationVisibility String    @default("private") @map("organization_visibility")
  productVisibility      String    @default("private") @map("product_visibility")
  batchVisibility        String    @default("private") @map("batch_visibility")
  timelineVisibility     String    @default("private") @map("timeline_visibility")
  evidenceVisibility     String    @default("private") @map("evidence_visibility")
  createdBySub           String    @map("created_by_sub")
  approvedBySub          String?   @map("approved_by_sub")
  approvedAt             DateTime? @map("approved_at") @db.Timestamptz(6)
  revokedBySub           String?   @map("revoked_by_sub")
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(6)

  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([batchId, policyVersion], map: "uq_passport_policy_version")
  @@index([batchId, state], map: "idx_passport_policy_state")
  @@map("passport_policy")
  @@schema("traceability")
}

model QrToken {
  id           String    @id @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  batchId      String    @map("batch_id") @db.Uuid
  tokenHash    String    @unique(map: "uq_qr_token_hash") @map("token_hash") @db.Char(64)
  state        String    @default("revoked")
  expiresAt    DateTime? @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdBySub String    @map("created_by_sub")

  batch Batch @relation(fields: [batchId], references: [id])

  @@index([batchId, state], map: "idx_qr_batch_state")
  @@map("qr_token")
  @@schema("traceability")
}
