// Platform baseline (P01-T03). Extend per database-schema-v1.md in later phases.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["platform"]
}

model AuditLog {
  id             String   @id @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actorSub       String?  @map("actor_sub")
  clientId       String?  @map("client_id")
  action         String
  targetType     String   @map("target_type")
  targetId       String   @map("target_id")
  outcome        String
  requestId      String   @map("request_id")
  correlationId  String?  @map("correlation_id")
  beforeSummary  Json     @default("{}") @map("before_summary") @db.JsonB
  afterSummary   Json     @default("{}") @map("after_summary") @db.JsonB

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([requestId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_log")
  @@schema("platform")
}

model Attachment {
  id                String   @id @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version           Int      @default(1)
  ownerType         String   @map("owner_type")
  ownerId           String?  @map("owner_id") @db.Uuid
  bucket            String
  objectKey         String   @map("object_key")
  sha256Hex         String   @map("sha256_hex") @db.Char(64)
  mimeType          String   @map("mime_type")
  sizeBytes         BigInt   @map("size_bytes")
  scanState         String   @map("scan_state")
  visibility        String   @default("private")
  createdBySub      String   @map("created_by_sub")
  scannedAt         DateTime? @map("scanned_at") @db.Timestamptz(6)
  scanEngineVersion String?  @map("scan_engine_version")

  @@unique([bucket, objectKey])
  @@index([ownerType, ownerId])
  @@index([scanState, createdAt])
  @@map("attachment")
  @@schema("platform")
}

model CoreRecord {
  id            String   @id @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  version       Int      @default(1)
  kind          String
  sourceType    String   @map("source_type")
  sourceId      String   @map("source_id")
  payload       Json     @db.JsonB
  visibility    String   @default("private")
  policyVersion String   @map("policy_version")
  checksumHex   String   @map("checksum_hex") @db.Char(64)
  builtAt       DateTime @map("built_at") @db.Timestamptz(6)

  @@unique([kind, sourceType, sourceId])
  @@index([kind, builtAt(sort: Desc)])
  @@map("core_record")
  @@schema("platform")
}
