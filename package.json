{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:dxlab": "next build apps/dx-lab",
    "generate:dxlab-api": "node scripts/generate-dxlab-api-types.mjs",
    "check:dxlab-api": "node scripts/generate-dxlab-api-types.mjs --check",
    "start": "node deploy/config.mjs --runtime erp && next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "build:worker": "tsc -p tsconfig.worker.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check && redocly lint contracts/openapi/nexora-v1.yaml --format=summary",
    "test:contracts": "npm run check:openapi && node scripts/validate-contracts.mjs && node scripts/run-python-jcs.mjs && node --test --require tsx/cjs contracts/events/federation.test.ts",
    "test:identity": "node --test --require tsx/cjs platform/identity/token.test.ts platform/identity/partner-actor.test.ts",
    "test:catalog": "node --test --require tsx/cjs contexts/catalog/domain/quantity.test.ts contexts/catalog/domain/normalize-uom.test.ts contexts/inventory/application/adjust-stock.test.ts",
    "test:trading": "node --test --require tsx/cjs contexts/trading/domain/document.test.ts contexts/trading/application/inbound-announcements.test.ts",
    "test:federation:outbound": "node --test --require tsx/cjs workers/federation-outbound.test.ts",
    "test:http": "node --test --require tsx/cjs platform/http/pipeline.test.ts platform/http/idempotency.test.ts",
    "test:platform:schema": "node scripts/run-platform-test.mjs schema",
    "test:transaction:unit": "node --test --require tsx/cjs platform/persistence/transaction.test.ts",
    "test:platform:transaction": "node scripts/run-platform-test.mjs transaction",
    "test:audit:unit": "node --test --require tsx/cjs platform/audit/audit.test.ts",
    "test:platform:audit": "node scripts/run-platform-test.mjs audit",
    "test:platform:records": "node scripts/run-platform-test.mjs records",
    "test:platform:evidence": "node scripts/run-platform-test.mjs evidence",
    "test:platform:files": "node scripts/run-platform-test.mjs files",
    "test:platform:scan": "node scripts/run-platform-test.mjs scan",
    "test:platform:idempotency": "node scripts/run-platform-test.mjs idempotency",
    "test:platform:outbox": "node scripts/run-platform-test.mjs outbox",
    "test:platform:events": "node scripts/run-platform-test.mjs events",
    "test:platform:workflow": "node scripts/run-platform-test.mjs workflow",
    "test:platform:workflow-bridge": "node scripts/run-platform-test.mjs workflow-bridge",
    "test:platform:trading": "node scripts/run-platform-test.mjs trading",
    "test:platform:trace": "node scripts/run-platform-test.mjs trace",
    "test:platform:federation": "node scripts/run-platform-test.mjs federation",
    "test:platform:ops": "node scripts/run-platform-test.mjs ops",
    "test:ai:tools": "node --test --require tsx/cjs contexts/ai/application/execute-tool.test.ts",
    "test:ai:compose": "node --test tests/ai/compose-boundary.test.mjs",
    "test:ai:golden": "node --test --require tsx/cjs tests/ai/lot-lookup.golden.test.ts",
    "test:ai:draft": "node --test --require tsx/cjs tests/ai/draft-receipt.golden.test.ts contexts/ai/application/draft-receipt.test.ts",
    "test:ai:adversarial": "node --test --require tsx/cjs tests/ai/draft-adversarial.test.ts",
    "test:ai:t06": "node --test --require tsx/cjs tests/ai/adversarial-t06.test.ts",
    "test:ai:security": "npm run test:ai:tools && npm run test:ai:golden && npm run test:ai:draft && npm run test:ai:risk && npm run test:ai:t06",
    "test:ai:risk": "node --test --require tsx/cjs tests/ai/risk-rules.golden.test.ts contexts/ai/application/risk-rules.test.ts tests/ai/risk-feedback.route.test.ts",
    "test:dxlab:auth": "node --test --require tsx/cjs apps/dx-lab/lib/auth/paths.test.ts apps/dx-lab/lib/auth/navigation.test.ts",
    "test:platform:ai-tools": "node scripts/run-platform-test.mjs ai-tools",
    "test:gateway": "node --test tests/gateway/private.test.mjs tests/gateway/public.test.mjs tests/gateway/m2m.test.mjs tests/gateway/policy.test.mjs tests/system/m01-policy.test.mjs",
    "test": "npm run check:spdx && npm run check:licenses && npm run check:secrets && npm run test:contracts && node --test deploy/config.test.mjs && npm run test:identity && npm run test:catalog && npm run test:trading && npm run test:federation:outbound && npm run test:ai:compose && npm run test:ai:tools && npm run test:ai:golden && npm run test:ai:draft && npm run test:ai:adversarial && npm run test:ai:risk && npm run test:gateway && npm run test:transaction:unit && npm run test:audit:unit && npm run test:http && node --test --require tsx/cjs platform/workflow/flowable-client.test.ts platform/workflow/approval-service.test.ts platform/workflow/flowable-decider.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@prisma/client": "6.19.0",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "busboy": "1.6.0",
    "canonicalize": "5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.17",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.1"
  },
  "devDependencies": {
    "@redocly/cli": "2.79.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "^5",
    "yaml": "2.8.1"
  }
}
