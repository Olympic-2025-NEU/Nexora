{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node deploy/config.mjs --runtime erp && next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check && redocly lint contracts/openapi/nexora-v1.yaml --format=summary",
    "test:contracts": "npm run check:openapi && node scripts/validate-contracts.mjs && python3 scripts/check-jcs-python.py",
    "test:identity": "node --test --require tsx/cjs platform/identity/token.test.ts",
    "test:gateway": "node --test tests/gateway/private.test.mjs tests/gateway/public.test.mjs tests/gateway/m2m.test.mjs tests/gateway/policy.test.mjs",
    "test": "npm run check:spdx && npm run check:licenses && npm run check:secrets && npm run test:contracts && node --test deploy/config.test.mjs && npm run test:identity && npm run test:gateway"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.79.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "canonicalize": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "^5",
    "yaml": "2.8.1"
  }
}
