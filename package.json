{
  "name": "nexora",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node deploy/config.mjs --runtime erp && next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "build:worker": "tsc -p tsconfig.worker.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "check:openapi": "node scripts/generate-openapi.mjs --check && redocly lint contracts/openapi/nexora-v1.yaml --format=summary",
    "test:contracts": "npm run check:openapi && node scripts/validate-contracts.mjs && node scripts/run-python-jcs.mjs",
    "test:identity": "node --test --require tsx/cjs platform/identity/token.test.ts platform/identity/partner-actor.test.ts",
    "test:http": "node --test --require tsx/cjs platform/http/pipeline.test.ts platform/http/idempotency.test.ts",
    "test:platform:schema": "node scripts/run-platform-test.mjs schema",
    "test:transaction:unit": "node --test --require tsx/cjs platform/persistence/transaction.test.ts",
    "test:platform:transaction": "node scripts/run-platform-test.mjs transaction",
    "test:audit:unit": "node --test --require tsx/cjs platform/audit/audit.test.ts",
    "test:platform:audit": "node scripts/run-platform-test.mjs audit",
    "test:platform:records": "node scripts/run-platform-test.mjs records",
    "test:platform:evidence": "node scripts/run-platform-test.mjs evidence",
    "test:platform:files": "node scripts/run-platform-test.mjs files",
    "test:platform:scan": "node scripts/run-platform-test.mjs scan",
    "test:platform:idempotency": "node scripts/run-platform-test.mjs idempotency",
    "test:platform:outbox": "node scripts/run-platform-test.mjs outbox",
    "test:platform:events": "node scripts/run-platform-test.mjs events",
    "test:platform:workflow": "node scripts/run-platform-test.mjs workflow",
    "test:platform:workflow-bridge": "node scripts/run-platform-test.mjs workflow-bridge",
    "test:platform:ops": "node scripts/run-platform-test.mjs ops",
    "test:gateway": "node --test tests/gateway/private.test.mjs tests/gateway/public.test.mjs tests/gateway/m2m.test.mjs tests/gateway/policy.test.mjs tests/system/m01-policy.test.mjs",
    "test": "npm run check:spdx && npm run check:licenses && npm run check:secrets && npm run test:contracts && node --test deploy/config.test.mjs && npm run test:identity && npm run test:gateway && npm run test:transaction:unit && npm run test:audit:unit && npm run test:http && node --test --require tsx/cjs platform/workflow/flowable-client.test.ts platform/workflow/approval-service.test.ts platform/workflow/flowable-decider.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@prisma/client": "6.19.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "busboy": "1.6.0",
    "canonicalize": "5.1.0",
    "jose": "^6.2.17",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@redocly/cli": "2.79.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.5",
    "typescript": "^5",
    "yaml": "2.8.1"
  }
}
