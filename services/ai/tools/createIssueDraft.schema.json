{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:nexora:ai:createIssueDraft:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["warehouseId", "batchId", "quantity", "unit", "purpose"],
  "properties": {
    "warehouseId": { "type": "string", "format": "uuid" },
    "batchId": { "type": "string", "format": "uuid" },
    "quantity": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,3})?$", "maxLength": 24 },
    "unit": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,12}$" },
    "purpose": { "enum": ["partner_transfer", "sale", "other"] },
    "note": { "type": "string", "maxLength": 200 }
  }
}
