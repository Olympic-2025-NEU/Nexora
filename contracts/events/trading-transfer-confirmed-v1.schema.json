{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trading.transfer.confirmed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "transferId",
    "linkedIssueId",
    "destinationPartnerId",
    "lines",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "transferId": {
      "type": "string",
      "format": "uuid"
    },
    "linkedIssueId": {
      "type": "string",
      "format": "uuid"
    },
    "destinationPartnerId": {
      "type": "string",
      "format": "uuid"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLineId",
          "batchId",
          "originLot",
          "quantity",
          "unit"
        ],
        "properties": {
          "sourceLineId": {
            "type": "string",
            "format": "uuid"
          },
          "batchId": {
            "type": "string",
            "format": "uuid"
          },
          "originLot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuerInstanceId",
              "lotId"
            ],
            "properties": {
              "issuerInstanceId": {
                "type": "string",
                "minLength": 1
              },
              "lotId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!0(?:\\.0{1,3})?$)(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "L"
            ]
          }
        }
      }
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
