{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trading.issue.confirmed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "documentId",
    "documentVersion",
    "lines",
    "movementIds",
    "actorSub",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "documentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lineId",
          "batchId",
          "warehouseId",
          "originLot",
          "quantity",
          "unit"
        ],
        "properties": {
          "lineId": {
            "type": "string",
            "format": "uuid"
          },
          "batchId": {
            "type": "string",
            "format": "uuid"
          },
          "warehouseId": {
            "type": "string",
            "format": "uuid"
          },
          "originLot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuerInstanceId",
              "lotId"
            ],
            "properties": {
              "issuerInstanceId": {
                "type": "string",
                "minLength": 1
              },
              "lotId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!0(?:\\.0{1,3})?$)(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "L"
            ]
          }
        }
      }
    },
    "movementIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "actorSub": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
