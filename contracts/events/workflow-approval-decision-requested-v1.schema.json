{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "workflow.approval.decision_requested.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "approvalRequestId",
    "documentId",
    "taskId",
    "decision",
    "requestedBySub",
    "requestedAt",
    "lineSnapshotSha256",
    "intentVersion"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "approvalRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "documentId": {
      "type": "string",
      "format": "uuid"
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "intentVersion": {
      "type": "integer",
      "minimum": 2
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "rejected"
      ]
    },
    "decisionReason": {
      "type": "string",
      "minLength": 1
    },
    "requestedBySub": {
      "type": "string",
      "minLength": 1
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "lineSnapshotSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
