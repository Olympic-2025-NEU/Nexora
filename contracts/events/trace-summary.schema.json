{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/contracts/events/trace-summary.schema.json",
  "title": "TraceSummaryV1",
  "allOf": [
    { "$ref": "envelope-v1.schema.json" },
    {
      "type": "object",
      "required": ["targetLot", "traceSummaries"],
      "properties": { "eventType": { "const": "trace.summary.v1" } },
      "not": { "anyOf": [
        { "required": ["linkedIssueId"] }, { "required": ["sentQuantity"] },
        { "required": ["sourceTransfer"] }, { "required": ["actualLines"] },
        { "required": ["actualQuantity"] }, { "required": ["discrepancyQuantity"] },
        { "required": ["discrepancyReason"] }, { "required": ["originLot"] },
        { "required": ["downstreamPartnerRef"] }, { "required": ["impactType"] },
        { "required": ["sourceEventRefs"] }, { "required": ["disclosureScope"] }
      ] }
    }
  ]
}
