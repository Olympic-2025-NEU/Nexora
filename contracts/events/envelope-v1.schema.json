{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/contracts/events/envelope-v1.schema.json",
  "title": "FederationEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "messageId",
    "eventId",
    "eventType",
    "issuerInstanceId",
    "recipientInstanceId",
    "occurredAt",
    "publishedAt",
    "correlationId",
    "causationId",
    "sourceDocument",
    "lots",
    "upstreamReferences",
    "evidence",
    "sharingPolicyVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "messageId": {
      "type": "string",
      "format": "uuid"
    },
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "transfer.announced.v1",
        "receipt.confirmed.v1",
        "downstream.impact.v1",
        "trace.summary.v1"
      ]
    },
    "issuerInstanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "recipientInstanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "causationId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id",
        "version"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "partner_transfer",
            "receiving_confirmation",
            "sale_record",
            "trace_summary"
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "lots": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLineId",
          "originLot",
          "senderBatch",
          "product",
          "quantity",
          "unit"
        ],
        "properties": {
          "sourceLineId": {
            "type": "string",
            "format": "uuid"
          },
          "originLot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuerInstanceId",
              "lotId"
            ],
            "properties": {
              "issuerInstanceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "lotId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "senderBatch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "batchId"
            ],
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "batchId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "product": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "instanceId",
              "productId"
            ],
            "properties": {
              "instanceId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "productId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "quantity": {
            "type": "string",
            "pattern": "^(?!0(?:\\.0{1,3})?$)(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "L"
            ]
          }
        }
      }
    },
    "upstreamReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuerInstanceId",
          "messageId",
          "eventId"
        ],
        "properties": {
          "issuerInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "messageId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "maxItems": 100
    },
    "evidence": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "checksum",
          "visibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "checksum": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "visibility": {
            "enum": [
              "partner",
              "public"
            ]
          }
        }
      }
    },
    "sharingPolicyVersion": {
      "type": "string",
      "minLength": 1
    },
    "linkedIssueId": {
      "type": "string",
      "format": "uuid"
    },
    "sentQuantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
    },
    "sourceTransfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerInstanceId",
        "id"
      ],
      "properties": {
        "issuerInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "id": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "actualLines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLineId",
          "receiverBatchId",
          "sentQuantity",
          "actualQuantity",
          "unit"
        ],
        "properties": {
          "sourceLineId": {
            "type": "string",
            "format": "uuid"
          },
          "receiverBatchId": {
            "type": "string",
            "format": "uuid"
          },
          "sentQuantity": {
            "type": "string",
            "pattern": "^(?!0(?:\\.0{1,3})?$)(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
          },
          "actualQuantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "L"
            ]
          }
        }
      },
      "minItems": 1,
      "maxItems": 100
    },
    "actualQuantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
    },
    "discrepancyQuantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
    },
    "discrepancyReason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "originLot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerInstanceId",
        "lotId"
      ],
      "properties": {
        "issuerInstanceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "lotId": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "downstreamPartnerRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "impactType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sourceEventRefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issuerInstanceId",
          "eventId"
        ],
        "properties": {
          "issuerInstanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "minItems": 1,
      "maxItems": 100
    },
    "disclosureScope": {
      "type": "string",
      "enum": [
        "partner",
        "public"
      ]
    },
    "targetLot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originLot", "senderBatch"],
      "properties": {
        "originLot": { "$ref": "#/$defs/originLot" },
        "senderBatch": { "$ref": "#/$defs/senderBatch" }
      }
    },
    "traceSummaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/traceSummary" }
    }
  },
  "$defs": {
    "originLot": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerInstanceId", "lotId"],
      "properties": {
        "issuerInstanceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "lotId": { "type": "string", "format": "uuid" }
      }
    },
    "senderBatch": {
      "type": "object", "additionalProperties": false,
      "required": ["instanceId", "batchId"],
      "properties": {
        "instanceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "batchId": { "type": "string", "format": "uuid" }
      }
    },
    "eventRef": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerInstanceId", "externalEventId"],
      "properties": {
        "issuerInstanceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "externalEventId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "messageRef": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerInstanceId", "messageId", "eventId"],
      "properties": {
        "issuerInstanceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "messageId": { "type": "string", "format": "uuid" },
        "eventId": { "type": "string", "format": "uuid" }
      }
    },
    "traceSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["issuerInstanceId", "externalEventId", "eventType", "occurredAt", "disclosureScope", "policyVersion", "state", "parents"],
      "properties": {
        "issuerInstanceId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "externalEventId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "eventType": { "type": "string", "minLength": 1, "maxLength": 80 },
        "occurredAt": { "type": "string", "format": "date-time" },
        "disclosureScope": { "enum": ["partner", "public"] },
        "policyVersion": { "type": "integer", "minimum": 1 },
        "state": { "enum": ["active", "revoked"] },
        "sourceMessageRef": { "$ref": "#/$defs/messageRef" },
        "parents": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/eventRef" } }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "transfer.announced.v1"
          }
        }
      },
      "then": {
        "required": [
          "linkedIssueId",
          "sentQuantity"
        ],
        "properties": {
          "sourceDocument": {
            "properties": {
              "type": {
                "const": "partner_transfer"
              }
            }
          },
          "lots": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "receipt.confirmed.v1"
          }
        }
      },
      "then": {
        "required": [
          "sourceTransfer",
          "actualLines",
          "sentQuantity",
          "actualQuantity",
          "discrepancyQuantity"
        ],
        "properties": {
          "sourceDocument": {
            "properties": {
              "type": {
                "const": "receiving_confirmation"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "downstream.impact.v1"
          }
        }
      },
      "then": {
        "required": [
          "originLot",
          "downstreamPartnerRef",
          "impactType",
          "sourceEventRefs",
          "disclosureScope"
        ],
        "properties": {
          "sourceDocument": {
            "properties": {
              "type": {
                "enum": [
                  "partner_transfer",
                  "sale_record"
                ]
              }
            }
          },
          "lots": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": { "properties": { "eventType": { "const": "trace.summary.v1" } } },
      "then": {
        "required": ["targetLot", "traceSummaries"],
        "properties": {
          "lots": { "maxItems": 0 },
          "sourceDocument": { "properties": { "type": { "const": "trace_summary" } } }
        }
      }
    }
  ]
}
