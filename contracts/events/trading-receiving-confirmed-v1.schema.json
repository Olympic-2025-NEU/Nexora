{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trading.receiving.confirmed.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "receivingId",
    "sourceIssuerInstanceId",
    "sourceTransferId",
    "sentLines",
    "actualLines",
    "occurredAt"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "receivingId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceIssuerInstanceId": {
      "type": "string",
      "minLength": 1
    },
    "sourceTransferId": {
      "type": "string",
      "format": "uuid"
    },
    "sentLines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLineId",
          "originLot",
          "sentQuantity",
          "unit"
        ],
        "properties": {
          "sourceLineId": {
            "type": "string",
            "format": "uuid"
          },
          "originLot": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuerInstanceId",
              "lotId"
            ],
            "properties": {
              "issuerInstanceId": {
                "type": "string",
                "minLength": 1
              },
              "lotId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "sentQuantity": {
            "type": "string",
            "pattern": "^(?!0(?:\\.0{1,3})?$)(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "L"
            ]
          }
        }
      }
    },
    "actualLines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLineId",
          "localBatchId",
          "actualQuantity",
          "unit"
        ],
        "properties": {
          "sourceLineId": {
            "type": "string",
            "format": "uuid"
          },
          "localBatchId": {
            "type": "string",
            "format": "uuid"
          },
          "actualQuantity": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$"
          },
          "unit": {
            "type": "string",
            "enum": [
              "EA",
              "KG",
              "L"
            ]
          }
        }
      }
    },
    "discrepancyReason": {
      "type": "string",
      "minLength": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
