{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "trace_projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "originLot",
    "sourceEventIds",
    "nodes",
    "edges",
    "transformVersion",
    "asOf"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "originLot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerInstanceId",
        "lotId"
      ],
      "properties": {
        "issuerInstanceId": {
          "type": "string",
          "minLength": 1
        },
        "lotId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceEventIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "eventId",
          "issuerInstanceId",
          "type",
          "occurredAt",
          "verificationState"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "issuerInstanceId": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "verificationState": {
            "type": "string",
            "enum": [
              "local_verified",
              "partner_asserted",
              "missing"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fromEventId",
          "relation"
        ],
        "properties": {
          "fromEventId": {
            "type": "string",
            "format": "uuid"
          },
          "toEventId": {
            "type": "string",
            "format": "uuid"
          },
          "missingRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "issuerInstanceId",
              "eventId"
            ],
            "properties": {
              "issuerInstanceId": {
                "type": "string",
                "minLength": 1
              },
              "eventId": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "relation": {
            "type": "string",
            "minLength": 1
          },
          "allocationDetail": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["issueLineId", "sourceLineId", "quantity"],
              "properties": {
                "issueLineId": { "type": "string", "format": "uuid" },
                "sourceLineId": { "type": "string", "format": "uuid" },
                "quantity": { "type": "string", "pattern": "^(?!0(?:\\.0{1,3})?$)(0|[1-9][0-9]*)(\\.[0-9]{1,3})?$" }
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "toEventId"
            ]
          },
          {
            "required": [
              "missingRef"
            ]
          }
        ]
      }
    },
    "transformVersion": {
      "type": "string",
      "minLength": 1
    },
    "asOf": {
      "type": "string",
      "format": "date-time"
    }
  }
}
