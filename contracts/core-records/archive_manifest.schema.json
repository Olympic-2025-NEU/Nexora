{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "archive_manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "objectKey",
    "sha256Hex",
    "recordCount",
    "firstOccurredAt",
    "lastOccurredAt",
    "sourceMinId",
    "sourceMaxId",
    "exportedAt",
    "checkpoint",
    "format"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "objectKey": {
      "type": "string",
      "minLength": 1
    },
    "sha256Hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordCount": {
      "type": "integer",
      "minimum": 0
    },
    "firstOccurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "lastOccurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "sourceMinId": {
      "type": "string",
      "minLength": 1
    },
    "sourceMaxId": {
      "type": "string",
      "minLength": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "format": {
      "const": "jsonl"
    }
  }
}
