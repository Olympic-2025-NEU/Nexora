{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "evidence_metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "ownerType",
    "ownerId",
    "attachmentId",
    "title"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ownerType": {
      "enum": [
        "document",
        "batch",
        "trace_event"
      ]
    },
    "ownerId": {
      "type": "string",
      "format": "uuid"
    },
    "attachmentId": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
