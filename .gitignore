# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/worker/dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example
!deploy/.env.example
!deploy/instances/*.env.example
deploy/instances/*.env
deploy/apisix/apisix.generated.yaml
deploy/instances/*/apisix.generated.yaml
deploy/instances/*/fixture-manifest.json
deploy/instances/abc-drill-result.json
deploy/certs/*.pem
deploy/certs/*-key.pem
deploy/certs/*.key
!deploy/certs/.gitkeep
!deploy/certs/README.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
