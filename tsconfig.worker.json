{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "worker/dist"
  },
  "include": ["workers/outbox-dispatcher.ts", "platform/outbox/*.ts", "platform/http/idempotency.ts",
    "composition/event-handlers.ts", "contracts/events/registry.ts"]
}
