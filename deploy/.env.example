# Shared names for deploy/compose.yml. Copy to deploy/instances/{a,b,c}.env for real runs.
# DEV DEFAULTS ARE INSECURE — change before any shared/demo host. Do not commit real .env files.

INSTANCE_ID=a
ORG_CODE=ORG-A
PUBLIC_BASE_URL=http://127.0.0.1:19080
GATEWAY_HTTP_PORT=19080
GATEWAY_HTTPS_PORT=19080
POSTGRES_HOST_PORT=15432
KEYCLOAK_HOST_PORT=18080

# PostgreSQL bootstrap administrator; never used by app/Keycloak/Flowable
POSTGRES_USER=nexora_admin
POSTGRES_PASSWORD=CHANGE_ME_PG_ADMIN
APP_DB_NAME=nexora
APP_DB_USER=app_runtime
APP_DB_PASSWORD=CHANGE_ME_APP_DB
CORE_DB_USER=core_data
CORE_DB_PASSWORD=CHANGE_ME_CORE_DB
MIGRATOR_DB_USER=migrator
MIGRATOR_DB_PASSWORD=CHANGE_ME_MIGRATOR_DB
APP_DATABASE_URL=postgresql://app_runtime:CHANGE_ME_APP_DB@postgres:5432/nexora
CORE_DATABASE_URL=postgresql://core_data:CHANGE_ME_CORE_DB@postgres:5432/nexora
MIGRATOR_DATABASE_URL=postgresql://migrator:CHANGE_ME_MIGRATOR_DB@postgres:5432/nexora
KEYCLOAK_DATABASE_URL=postgresql://keycloak:CHANGE_ME_KC_DB@postgres:5432/keycloak
FLOWABLE_DATABASE_URL=postgresql://flowable:CHANGE_ME_FLOWABLE_DB@postgres:5432/flowable

# Keycloak DB (separate database/role on same Postgres instance)
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_KC_DB
KEYCLOAK_DB_NAME=keycloak
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KC_ADMIN
KC_DEV_USERNAME=dev-staff
KC_DEV_USER_PASSWORD=CHANGE_ME_DEV_TEMP_PASSWORD

# Flowable DB
FLOWABLE_DB_USER=flowable
FLOWABLE_DB_PASSWORD=CHANGE_ME_FLOWABLE_DB
FLOWABLE_DB_NAME=flowable
FLOWABLE_ADMIN_USER=flowable-admin
FLOWABLE_ADMIN_PASSWORD=CHANGE_ME_FLOWABLE_ADMIN
FLOWABLE_BASE_URL=http://flowable:8080/flowable-rest
FLOWABLE_AUTH_REF=env:FLOWABLE_ADMIN_PASSWORD
FLOWABLE_PROCESS_KEY=goods-issue-approval

# OIDC (issuer internal hostname for containers; browser issuer aligned in P02)
OIDC_ISSUER_URL=http://keycloak:8080/realms/nexora
OIDC_BASE_URL=http://keycloak:8080
OIDC_JWKS_URL=http://keycloak:8080/realms/nexora/protocol/openid-connect/certs
OIDC_AUDIENCE=erp-browser
OIDC_CLIENT_ID_ERP=erp-browser
OIDC_CLIENT_ID_DXLAB=dxlab-browser
OIDC_REDIRECT_URI_ERP=http://127.0.0.1:19080/erp/callback
OIDC_REDIRECT_URI_DXLAB=http://127.0.0.1:19080/dxlab/callback

# Partner connection metadata only; secret: references resolve outside this bootstrap.
PARTNER_OUTBOUND_CLIENT_ID=partner-outbound-a
PARTNER_OUTBOUND_SECRET_REF=secret:partner-outbound-a
PARTNER_OUTBOUND_TOKEN_URL=http://keycloak:8080/realms/nexora/protocol/openid-connect/token
PARTNER_OUTBOUND_AUDIENCE=partner-inbound-a
PARTNER_INBOUND_CLIENT_ID=partner-inbound-a

# SeaweedFS S3 (private buckets; no public console port)
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_SECRET_REF=env:S3_SECRET_KEY
S3_ACCESS_KEY=CHANGE_ME_S3_ACCESS
S3_SECRET_KEY=CHANGE_ME_S3_SECRET
S3_SCANNER_ACCESS_KEY=CHANGE_ME_S3_SCANNER_ACCESS
S3_SCANNER_SECRET_KEY=CHANGE_ME_S3_SCANNER_SECRET
S3_ADMIN_ACCESS_KEY=CHANGE_ME_S3_ADMIN_ACCESS
S3_ADMIN_SECRET_KEY=CHANGE_ME_S3_ADMIN_SECRET
S3_BUCKET_PRIVATE=nexora-private
S3_BUCKET_QUARANTINE=nexora-quarantine
S3_BUCKET_PUBLIC=nexora-public

# Redis (cache only; outbox SoT remains Postgres)
REDIS_URL=redis://redis:6379/0

# Optional AI profile
AI_BASE_URL=http://ai:8080
AI_PROVIDER=none
AI_KEY_REF=
