# Shared variable catalog for deploy/compose.yml (P01-T01).
# UNSAFE DEV DEFAULTS — change before any shared or public demo. Never commit real secrets.
# Prefer instance files: deploy/instances/{a,b,c}.env.example → copy to *.env (gitignored).

# --- Instance identity ---
INSTANCE_ID=a
ORG_CODE=ORG_A
PUBLIC_BASE_URL=http://127.0.0.1:19080
GATEWAY_HOST_PORT=19080

# --- PostgreSQL bootstrap (superuser for container init; roles = P01-T03) ---
POSTGRES_SUPERUSER=nexora
POSTGRES_SUPERUSER_PASSWORD=nexora_dev_change_me
POSTGRES_APP_DB=nexora
# Only used with -f deploy/compose.dev-db-publish.yml
POSTGRES_HOST_PORT=5433

# App / core JDBC-style URLs (placeholders until P01-T03 roles exist)
APP_DATABASE_URL=postgresql://app_runtime:app_runtime_dev_change_me@postgres:5432/nexora
CORE_DATABASE_URL=postgresql://core_data:core_data_dev_change_me@postgres:5432/nexora
KEYCLOAK_JDBC_URL=jdbc:postgresql://postgres:5432/keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_dev_change_me
FLOWABLE_JDBC_URL=jdbc:postgresql://postgres:5432/flowable
FLOWABLE_DB_USER=flowable
FLOWABLE_DB_PASSWORD=flowable_dev_change_me

# --- Keycloak bootstrap (dev only) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin_dev_change_me
OIDC_ISSUER_URL=http://keycloak:8080/realms/nexora
OIDC_CLIENT_ID_ERP=nexora-erp
OIDC_CLIENT_ID_DXLAB=nexora-dxlab
OIDC_AUDIENCE=nexora-api
OIDC_JWKS_URL=http://keycloak:8080/realms/nexora/protocol/openid-connect/certs

# --- Flowable REST ---
FLOWABLE_BASE_URL=http://flowable:8080
FLOWABLE_ADMIN_USER=admin
FLOWABLE_ADMIN_PASSWORD=flowable_admin_dev_change_me
FLOWABLE_PROCESS_KEY=goods-issue-approval
FLOWABLE_AUTH_REF=env:FLOWABLE_ADMIN_PASSWORD

# --- Object storage (SeaweedFS S3) ---
S3_ENDPOINT=http://seaweedfs:8333
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=quarantine
S3_BUCKET_PRIVATE=private
S3_BUCKET_PUBLIC=public
S3_ACCESS_KEY=seaweed_dev_key
S3_SECRET_KEY=seaweed_dev_secret_change_me
S3_SECRET_REF=env:S3_SECRET_KEY

# --- Redis / AI (optional profile) ---
REDIS_URL=redis://redis:6379/0
AI_PROVIDER=stub
AI_BASE_URL=http://ai:8080
AI_KEY_REF=unset

# --- Partner M2M placeholders (wired in P02/P05; no real secrets here) ---
PARTNER_OUTBOUND_CLIENT_ID=
PARTNER_OUTBOUND_SECRET_REF=
PARTNER_OUTBOUND_TOKEN_URL=
PARTNER_OUTBOUND_AUDIENCE=
PARTNER_INBOUND_CLIENT_ID=
